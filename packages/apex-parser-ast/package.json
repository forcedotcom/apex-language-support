{
  "name": "@salesforce/apex-lsp-parser-ast",
  "version": "1.0.0",
  "description": "Apex Parser AST for Language Server",
  "main": "out/index.js",
  "module": "out/index.js",
  "types": "out/index.d.ts",
  "exports": {
    ".": {
      "import": "./out/index.js",
      "require": "./out/index.js"
    }
  },
  "sideEffects": false,
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/apex-language-support.git",
    "directory": "packages/apex-parser-ast"
  },
  "files": [
    "out",
    "resources",
    "README.md"
  ],
  "scripts": {
    "fetch:api-stubs": "node scripts/fetch-api-stubs.mjs",
    "generate:api-stubs": "node scripts/generate-api-stubs.mjs",
    "update:stubs": "pnpm run fetch:api-stubs && pnpm run generate:api-stubs",
    "generate:stdlib-cache": "wireit",
    "precompile": "wireit",
    "bundle": "wireit",
    "compile": "wireit",
    "test": "wireit",
    "test:one": "wireit",
    "test:coverage": "wireit",
    "test:perf": "wireit",
    "test:perf:quick": "QUICK=true pnpm run test:perf",
    "clean": "rimraf out dist resources .wireit coverage src/generated tsconfig.tsbuildinfo",
    "clean:all": "pnpm run clean && rimraf node_modules",
    "lint": "wireit",
    "typecheck": "wireit",
    "check:error-codes": "node scripts/check-error-code-coverage.mjs"
  },
  "wireit": {
    "generate:stdlib-cache": {
      "command": "node scripts/generate-stdlib-cache.mjs",
      "dependencies": [
        "compile:tsc"
      ],
      "clean": "if-file-deleted",
      "output": [
        "resources/apex-stdlib.pb.gz",
        "resources/apex-type-registry.pb.gz",
        "resources/apex-fqn-index.pb.gz",
        "resources/apex-stdlib.sha256"
      ],
      "files": [
        "src/resources/StandardApexLibrary/**/*.cls",
        "scripts/generate-stdlib-cache.mjs"
      ]
    },
    "precompile": {
      "command": "node scripts/generate-proto.mjs && node scripts/generate-keywords.mjs && node scripts/generate-primitive-types.mjs && node scripts/generate-zip.mjs && node scripts/generate-messages.mjs",
      "output": [
        "src/generated/**",
        "resources/StandardApexLibrary.zip",
        "resources/StandardApexLibrary.zip.md5"
      ],
      "files": [
        "scripts/generate-proto.mjs",
        "scripts/generate-keywords.mjs",
        "scripts/generate-primitive-types.mjs",
        "scripts/generate-zip.mjs",
        "scripts/generate-messages.mjs",
        "proto/apex-stdlib.proto",
        "src/**/*.cls",
        "src/resources/messages/messages_en_US.properties",
        "src/resources/builtins/primitive-metadata.json"
      ]
    },
    "compile:tsc": {
      "command": "tsc --build || tsc --build",
      "clean": "if-file-deleted",
      "dependencies": [
        "precompile"
      ],
      "output": [
        "out/**"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig*.json",
        "../../tsconfig.base.json"
      ]
    },
    "compile": {
      "dependencies": [
        "compile:tsc",
        "generate:stdlib-cache"
      ]
    },
    "typecheck": {
      "command": "tsc -p test/tsconfig.json --noEmit",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig.json",
        "test/tsconfig.json"
      ]
    },
    "bundle": {
      "command": "tsx esbuild.config.ts",
      "dependencies": [
        "compile:tsc",
        "generate:stdlib-cache"
      ],
      "output": [
        "dist/**"
      ],
      "files": [
        "src/**/*.ts",
        "esbuild.config.ts",
        "out/index.d.ts",
        "resources/apex-stdlib.pb.gz"
      ]
    },
    "test": {
      "command": "vitest run --reporter=json --outputFile=.wireit/test-results.json",
      "dependencies": [
        "compile"
      ],
      "output": [
        ".wireit/test-results.json"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --coverage.reportsDirectory=./coverage",
      "dependencies": [
        "compile"
      ],
      "output": [
        "coverage/**"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache src test",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "eslint.config.mjs"
      ],
      "output": []
    },
    "lint:fix": {
      "command": "eslint --fix --color --cache --cache-location .eslintcache src test",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "eslint.config.mjs"
      ],
      "output": []
    },
    "test:one": {
      "command": "vitest run resourceLoader --reporter=json --outputFile=.wireit/test-results-one.json",
      "dependencies": [
        "compile"
      ],
      "output": [
        ".wireit/test-results-one.json"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "test:perf": {
      "command": "vitest run --config vitest.config.perf.mts",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.perf.ts",
        "vitest.config.perf.mts"
      ]
    }
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "5.2.0",
    "@protobuf-ts/runtime": "^2.9.4",
    "@salesforce/apex-lsp-shared": "workspace:*",
    "@salesforce/vscode-i18n": "^66.8.0",
    "antlr4": "4.13.2",
    "data-structure-typed": "^2.6.4",
    "effect": "^3.22.1",
    "fflate": "^0.8.3",
    "spark-md5": "^3.0.2"
  },
  "devDependencies": {
    "@protobuf-ts/plugin": "^2.9.4",
    "@protobuf-ts/protoc": "^2.11.1",
    "@salesforce/esbuild-presets": "workspace:*",
    "@types/benchmark": "^2.1.5",
    "benchmark": "^2.1.4",
    "esbuild-plugin-copy": "^2.1.1",
    "vitest": "5.0.1"
  }
}
