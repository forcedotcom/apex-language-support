{
  "name": "@salesforce/apex-lsp-shared",
  "version": "1.0.0",
  "description": "Apex LSP shared utilities",
  "main": "out/index.js",
  "module": "out/index.js",
  "types": "out/index.d.ts",
  "browser": {
    "./out/observability/workerTracing.js": "./out/observability/workerTracing.browser.js",
    "./out/observability/coordinatorEffectTracing.js": "./out/observability/coordinatorEffectTracing.browser.js",
    "./out/observability/tracing.js": "./out/observability/tracing.browser.js"
  },
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "import": "./out/index.js",
      "require": "./out/index.js"
    },
    "./observability/workerTracing": {
      "types": "./out/observability/workerTracing.d.ts",
      "browser": "./out/observability/workerTracing.browser.js",
      "import": "./out/observability/workerTracing.js",
      "require": "./out/observability/workerTracing.js"
    },
    "./observability/workerTracing.browser": {
      "types": "./out/observability/workerTracing.browser.d.ts",
      "import": "./out/observability/workerTracing.browser.js",
      "require": "./out/observability/workerTracing.browser.js"
    },
    "./observability/coordinatorEffectTracing": {
      "types": "./out/observability/coordinatorEffectTracing.d.ts",
      "browser": "./out/observability/coordinatorEffectTracing.browser.js",
      "import": "./out/observability/coordinatorEffectTracing.js",
      "require": "./out/observability/coordinatorEffectTracing.js"
    },
    "./observability/coordinatorEffectTracing.browser": {
      "types": "./out/observability/coordinatorEffectTracing.browser.d.ts",
      "import": "./out/observability/coordinatorEffectTracing.browser.js",
      "require": "./out/observability/coordinatorEffectTracing.browser.js"
    }
  },
  "sideEffects": false,
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/apex-language-support.git",
    "directory": "packages/apex-lsp-shared"
  },
  "scripts": {
    "compile": "wireit",
    "bundle": "wireit",
    "dev": "tsx esbuild.config.ts --watch",
    "test": "wireit",
    "test:coverage": "wireit",
    "clean": "rimraf out dist .wireit coverage tsconfig.tsbuildinfo",
    "clean:all": "npm run clean && rimraf node_modules",
    "lint": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --build",
      "clean": "if-file-deleted",
      "output": [
        "out/**"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig*.json",
        "../../tsconfig.base.json"
      ]
    },
    "bundle": {
      "command": "tsx esbuild.config.ts",
      "dependencies": [
        "compile"
      ],
      "output": [
        "dist/**"
      ],
      "files": [
        "src/**/*.ts",
        "esbuild.config.ts"
      ]
    },
    "typecheck": {
      "command": "tsc -p test/tsconfig.json --noEmit",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig.json",
        "test/tsconfig.json"
      ]
    },
    "test": {
      "command": "jest --json --outputFile=.wireit/test-results.json",
      "dependencies": [
        "compile"
      ],
      "output": [
        ".wireit/test-results.json"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/jest.config.cjs"
      ]
    },
    "test:coverage": {
      "command": "jest --coverage --coverageDirectory=./coverage",
      "dependencies": [
        "compile"
      ],
      "output": [
        "coverage/**"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "**/jest.config.cjs"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache src test",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "eslint.config.mjs"
      ],
      "output": []
    },
    "lint:fix": {
      "command": "eslint --fix --color --cache --cache-location .eslintcache src test",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "eslint.config.mjs"
      ],
      "output": []
    }
  },
  "dependencies": {
    "@effect/opentelemetry": "^0.64.0",
    "@effect/platform": "^0.97.1",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/context-async-hooks": "^2.10.0",
    "@opentelemetry/core": "^2.10.0",
    "effect": "^3.22.1",
    "vscode-jsonrpc": "^8.2.1",
    "vscode-languageserver": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@jest/globals": "^30.4.1",
    "@salesforce/esbuild-presets": "^0.1.0"
  }
}
