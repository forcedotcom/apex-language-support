{
  "name": "@salesforce/apex-lsp-compliant-services",
  "version": "1.0.0",
  "description": "LSP Compliant Services for Apex Language Server",
  "main": "out/index.js",
  "module": "out/index.js",
  "types": "out/index.d.ts",
  "exports": {
    "import": "./out/index.js",
    "require": "./out/index.js"
  },
  "sideEffects": false,
  "license": "BSD-3-Clause",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/apex-language-support.git",
    "directory": "packages/lsp-compliant-services"
  },
  "scripts": {
    "compile": "wireit",
    "bundle": "wireit",
    "test": "wireit",
    "test:one": "wireit",
    "test:coverage": "wireit",
    "test:perf": "wireit",
    "test:perf:quick": "QUICK=true pnpm run test:perf",
    "clean": "rimraf out dist .wireit coverage tsconfig.tsbuildinfo",
    "clean:all": "pnpm run clean && rimraf node_modules",
    "lint": "wireit",
    "typecheck": "wireit"
  },
  "wireit": {
    "compile": {
      "command": "tsc --build",
      "clean": "if-file-deleted",
      "dependencies": [
        "../apex-lsp-shared:compile",
        "../apex-parser-ast:compile"
      ],
      "output": [
        "out/**"
      ],
      "files": [
        "src/**/*.ts",
        "tsconfig*.json",
        "../../tsconfig.base.json"
      ]
    },
    "typecheck": {
      "command": "tsc -p test/tsconfig.json --noEmit",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "tsconfig.json",
        "test/tsconfig.json"
      ]
    },
    "bundle": {
      "command": "tsx esbuild.config.ts",
      "dependencies": [
        "compile",
        "../esbuild-presets:compile",
        "../apex-parser-ast:compile"
      ],
      "output": [
        "dist/**"
      ],
      "files": [
        "src/**/*.ts",
        "esbuild.config.ts"
      ]
    },
    "test": {
      "command": "vitest run --reporter=json --outputFile=.wireit/test-results.json",
      "dependencies": [
        "compile",
        "typecheck"
      ],
      "output": [
        ".wireit/test-results.json"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "test:coverage": {
      "command": "vitest run --coverage --coverage.reportsDirectory=./coverage",
      "dependencies": [
        "compile"
      ],
      "output": [
        "coverage/**"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "lint": {
      "command": "eslint --color --cache --cache-location .eslintcache src test",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "eslint.config.mjs"
      ],
      "output": []
    },
    "lint:fix": {
      "command": "eslint --fix --color --cache --cache-location .eslintcache src test",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "eslint.config.mjs"
      ],
      "output": []
    },
    "test:one": {
      "command": "vitest run test/integration/HoverProcessingService.integration.test.ts -t \"should provide hover for method declaration testFileUtilities\" --reporter=json --outputFile=.wireit/test-results-one.json",
      "dependencies": [
        "compile"
      ],
      "output": [
        ".wireit/test-results-one.json"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.ts",
        "vitest.config.mts"
      ]
    },
    "test:perf": {
      "command": "vitest run --include=\"test/**/*.perf.ts\" --pool=forks --poolOptions.forks.singleFork",
      "dependencies": [
        "compile"
      ],
      "files": [
        "src/**/*.ts",
        "test/**/*.perf.ts",
        "vitest.config.mts"
      ]
    }
  },
  "dependencies": {
    "@apexdevtools/apex-parser": "5.2.0",
    "@salesforce/apex-lsp-parser-ast": "workspace:*",
    "@salesforce/apex-lsp-shared": "workspace:*",
    "antlr4": "4.13.2",
    "data-structure-typed": "^2.6.4",
    "effect": "^3.22.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-textdocument": "^1.0.15"
  },
  "devDependencies": {
    "@salesforce/esbuild-presets": "workspace:*",
    "@types/benchmark": "^2.1.5",
    "benchmark": "^2.1.4",
    "vitest": "5.0.1"
  }
}
