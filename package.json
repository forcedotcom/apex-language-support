{
  "name": "@salesforce/apex-language-server",
  "version": "1.0.0",
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  },
  "packageManager": "pnpm@12.10.1",
  "scripts": {
    "typecheck": "wireit",
    "test": "wireit",
    "test:eslint-rules": "wireit",
    "test:coverage": "wireit",
    "test:perf": "wireit",
    "test:perf:quick": "QUICK=true pnpm run test:perf",
    "test:quality": "wireit",
    "test:coverage:report": "wireit",
    "test:web": "wireit",
    "test:web:debug": "wireit",
    "test:web:prod": "node scripts/test-web-ext.js --prod",
    "test:web:full": "wireit",
    "test:e2e": "wireit",
    "test:e2e:debug": "pnpm --filter e2e-tests run test:debug",
    "test:e2e:server": "pnpm --filter e2e-tests run server",
    "test:e2e:visual": "pnpm --filter e2e-tests run test:visual",
    "test:e2e:web": "pnpm --filter e2e-tests run test:e2e:web",
    "test:e2e:web:chromium": "pnpm --filter e2e-tests run test:e2e:web:chromium",
    "test:e2e:desktop": "pnpm --filter e2e-tests run test:e2e:desktop",
    "test:e2e:desktop:debug": "pnpm --filter e2e-tests run test:e2e:desktop:debug",
    "test:e2e:desktop:chromium": "pnpm --filter e2e-tests run test:e2e:desktop:chromium",
    "test:e2e:desktop:webkit": "pnpm --filter e2e-tests run test:e2e:desktop:webkit",
    "test:e2e:desktop:all-browsers": "pnpm --filter e2e-tests run test:e2e:desktop:all-browsers",
    "lint": "wireit",
    "lint:fix": "wireit",
    "knip": "knip",
    "knip:fix": "knip --fix",
    "check:dupes": "jscpd",
    "check:dupes:strict": "jscpd --threshold 0",
    "check:dupes:parser-ast": "jscpd packages/apex-parser-ast/src --config .jscpd.json --output ./jscpd-report-parser-ast --threshold 10",
    "check:dupes:parser-ast:strict": "jscpd packages/apex-parser-ast/src --config .jscpd.json --output ./jscpd-report-parser-ast --threshold 0",
    "compile": "wireit",
    "prepare": "husky",
    "clean": "wireit",
    "clean:all": "wireit",
    "sync:testbed-fixtures": "wireit",
    "semantic-release": "semantic-release",
    "bundle": "wireit",
    "package": "wireit",
    "package:packages": "pnpm run package",
    "package:packages:prerelease": "wireit",
    "rebuild": "pnpm run clean && pnpm run compile && pnpm run bundle",
    "sync:vscode-version": "wireit",
    "sync:vscode-version:update": "node scripts/sync-vscode-version.js"
  },
  "keywords": [
    "salesforce",
    "apex",
    "language server",
    "lsp"
  ],
  "author": "Salesforce",
  "license": "BSD-3-Clause",
  "description": "Language Server Protocol implementation for Salesforce Apex",
  "repository": {
    "type": "git",
    "url": "https://github.com/forcedotcom/apex-language-support.git"
  },
  "bugs": {
    "url": "https://github.com/forcedotcom/apex-language-support/issues"
  },
  "homepage": "https://github.com/forcedotcom/apex-language-support#readme",
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@effect/language-service": "^0.87.2",
    "@salesforce/apex-lsp-compliant-services": "workspace:*",
    "@salesforce/apex-lsp-parser-ast": "workspace:*",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tony.ganchev/eslint-plugin-header": "^3.4.4",
    "@types/benchmark": "^2.1.5",
    "@types/node": "^20.19.43",
    "@types/semver": "^7.8.0",
    "@types/vscode": "1.120.0",
    "@typescript-eslint/eslint-plugin": "^8.69.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vscode/test-web": "^0.0.81",
    "benchmark": "^2.1.4",
    "chalk": "^5.3.0",
    "commander": "^14.0.3",
    "effect": "^3.22.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsdoc": "^62.8.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unused-imports": "^4.1.4",
    "glob": "^10.3.10",
    "husky": "^9.0.11",
    "istanbul-lib-coverage": "^3.2.2",
    "istanbul-lib-report": "^3.0.1",
    "istanbul-reports": "^3.1.7",
    "@vitest/coverage-v8": "5.0.1",
    "jscpd": "^4.3.0",
    "jsonc-eslint-parser": "^2.4.0",
    "knip": "^6.38.0",
    "prettier": "^3.9.6",
    "rimraf": "^5.0.5",
    "semantic-release": "^25.0.9",
    "semver": "^7.8.5",
    "shelljs": "^0.10.0",
    "simple-git": "^4.0.2",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vitest": "5.0.1",
    "wireit": "^0.14.13",
    "zod": "^4.6.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "^4.63.3",
    "@rollup/rollup-linux-x64-musl": "^4.63.1"
  },
  "dependencies": {
    "vscode-languageserver-protocol": "3.17.5",
    "vscode-languageserver-textdocument": "^1.0.15",
    "vscode-uri": "^3.2.0"
  },
  "overrides": {
    "vscode-jsonrpc": "8.2.1",
    "playwright": "1.62.1",
    "@playwright/browser-chromium": "1.62.1",
    "vscode-languageserver-protocol": "3.17.5"
  },
  "wireit": {
    "typecheck": {
      "dependencies": [
        "compile",
        "./packages/apex-parser-ast:typecheck",
        "./packages/apex-lsp-shared:typecheck",
        "./packages/apex-lsp-client:typecheck",
        "./packages/apex-ls:typecheck",
        "./packages/lsp-compliant-services:typecheck",
        "./packages/apex-lsp-vscode-extension:typecheck",
        "./packages/apex-lsp-testbed:typecheck"
      ]
    },
    "sync:vscode-version": {
      "command": "node scripts/sync-vscode-version.js --check",
      "files": [
        "scripts/sync-vscode-version.js",
        ".vscode-version"
      ],
      "output": [],
      "cache": false
    },
    "compile": {
      "dependencies": [
        "sync:vscode-version",
        "./packages/apex-ls:compile",
        "./packages/apex-lsp-shared:compile",
        "./packages/apex-lsp-client:compile",
        "./packages/apex-parser-ast:compile:tsc",
        "./packages/apex-parser-ast:generate:stdlib-cache",
        "./packages/lsp-compliant-services:compile",
        "./packages/custom-services:compile",
        "./packages/apex-lsp-testbed:compile",
        "./packages/apex-lsp-vscode-extension:compile",
        "./packages/esbuild-presets:compile"
      ]
    },
    "bundle": {
      "dependencies": [
        "compile",
        "./packages/apex-ls:bundle",
        "./packages/apex-lsp-shared:bundle",
        "./packages/apex-lsp-client:bundle",
        "./packages/apex-parser-ast:bundle",
        "./packages/lsp-compliant-services:bundle",
        "./packages/custom-services:bundle",
        "./packages/apex-lsp-vscode-extension:bundle"
      ]
    },
    "package": {
      "dependencies": [
        "bundle",
        "./packages/apex-lsp-vscode-extension:package",
        "./packages/apex-lsp-vscode-extension:package-web"
      ]
    },
    "package:packages:prerelease": {
      "dependencies": [
        "bundle",
        "./packages/apex-lsp-vscode-extension:package-prerelease",
        "./packages/apex-lsp-vscode-extension:package-web-prerelease"
      ]
    },
    "test": {
      "command": "node scripts/test-summary.js",
      "dependencies": [
        "compile",
        "test:eslint-rules",
        "./packages/apex-ls:test",
        "./packages/apex-ls:test:web",
        "./packages/apex-lsp-shared:test",
        "./packages/apex-lsp-client:test",
        "./packages/apex-lsp-testbed:test",
        "./packages/apex-lsp-vscode-extension:test",
        "./packages/apex-parser-ast:test",
        "./packages/custom-services:test",
        "./packages/lsp-compliant-services:test"
      ]
    },
    "test:eslint-rules": {
      "command": "node --test eslint-rules/parser-owned-semantics.test.mjs",
      "files": [
        "eslint-rules/index.mjs",
        "eslint-rules/parser-owned-semantics.test.mjs"
      ]
    },
    "test:coverage": {
      "dependencies": [
        "compile",
        "./packages/apex-ls:test:coverage",
        "./packages/apex-lsp-shared:test:coverage",
        "./packages/apex-lsp-client:test:coverage",
        "./packages/apex-lsp-testbed:test:coverage",
        "./packages/apex-lsp-vscode-extension:test:coverage",
        "./packages/apex-parser-ast:test:coverage",
        "./packages/custom-services:test:coverage",
        "./packages/lsp-compliant-services:test:coverage"
      ]
    },
    "test:perf": {
      "dependencies": [
        "compile",
        "./packages/apex-lsp-testbed:test:perf",
        "./packages/apex-parser-ast:test:perf",
        "./packages/lsp-compliant-services:test:perf"
      ]
    },
    "test:quality": {
      "dependencies": [
        "compile",
        "bundle",
        "./packages/apex-lsp-testbed:test:quality"
      ]
    },
    "server": {
      "command": "pnpm -r --if-present run server",
      "dependencies": [
        "compile"
      ],
      "cache": false
    },
    "test:debug": {
      "command": "pnpm -r --if-present run test:debug",
      "dependencies": [
        "compile"
      ],
      "cache": false
    },
    "test:visual": {
      "command": "pnpm -r --if-present run test:visual",
      "dependencies": [
        "compile"
      ],
      "cache": false
    },
    "test:web": {
      "command": "node scripts/test-web-ext.js",
      "dependencies": [
        "bundle"
      ],
      "cache": false
    },
    "test:web:debug": {
      "command": "node scripts/test-web-ext.js --log-level=debug",
      "dependencies": [
        "bundle"
      ],
      "cache": false
    },
    "test:web:full": {
      "command": "node scripts/test-web-ext.js --with-services",
      "dependencies": [
        "bundle"
      ],
      "cache": false
    },
    "test:e2e": {
      "command": "node scripts/test-e2e.js",
      "dependencies": [
        "bundle"
      ],
      "cache": false
    },
    "lint": {
      "command": "prettier --check \"packages/**/*.ts\"",
      "dependencies": [
        "./packages/apex-ls:lint",
        "./packages/apex-lsp-shared:lint",
        "./packages/apex-lsp-client:lint",
        "./packages/apex-parser-ast:lint",
        "./packages/lsp-compliant-services:lint",
        "./packages/custom-services:lint",
        "./packages/apex-lsp-testbed:lint",
        "./packages/apex-lsp-vscode-extension:lint",
        "./e2e-tests:lint"
      ]
    },
    "lint:fix": {
      "command": "prettier --write \"packages/**/*.ts\" --log-level warn",
      "dependencies": [
        "compile",
        "typecheck",
        "./packages/apex-ls:lint:fix",
        "./packages/apex-lsp-shared:lint:fix",
        "./packages/apex-lsp-client:lint:fix",
        "./packages/apex-parser-ast:lint:fix",
        "./packages/lsp-compliant-services:lint:fix",
        "./packages/custom-services:lint:fix",
        "./packages/apex-lsp-testbed:lint:fix",
        "./packages/apex-lsp-vscode-extension:lint:fix",
        "./e2e-tests:lint:fix"
      ]
    },
    "clean": {
      "command": "pnpm -r --if-present run clean && rimraf .wireit coverage test-artifacts",
      "cache": false
    },
    "clean:all": {
      "command": "pnpm -r --if-present run clean:all && rimraf node_modules coverage test-artifacts",
      "cache": false
    },
    "test:coverage:report": {
      "command": "node scripts/merge-coverage.js",
      "dependencies": [
        "test:coverage"
      ],
      "output": [
        "coverage/**"
      ],
      "files": [
        "scripts/merge-coverage.js",
        "packages/*/coverage/coverage-final.json"
      ]
    },
    "sync:testbed-fixtures": {
      "command": "node scripts/sync-testbed-fixtures.js",
      "output": [
        "packages/apex-lsp-testbed/test/fixtures/i-have-problems/force-app/main/default/classes/**"
      ],
      "files": [
        "scripts/sync-testbed-fixtures.js",
        "packages/apex-parser-ast/test/fixtures/validation/**"
      ]
    }
  }
}
