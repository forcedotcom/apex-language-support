{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/apex-lsp-vscode-extension",
        "--disable-extension=salesforce.salesforcedx-vscode-apex"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "trace": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/apex-lsp-vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "pnpm: bundle",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps",
        "APEX_LS_MODE": "development",
        "APEX_WORKER_EXPERIMENT": "1"
      }
    },
    {
      "name": "Attach to Language Server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "sourceMaps": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/apex-ls/out/**/*.js",
        "${workspaceFolder}/packages/apex-ls/dist/**/*.js"
      ]
    },
    {
      "name": "Debug Vitest Test (Prompt for Name)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "${file}",
        "run",
        "-t=${input:testName}",
        "--pool=forks",
        "--maxWorkers=1"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Debug Vitest Test (Selected Text)",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "${file}",
        "run",
        "-t=${selectedText}",
        "--pool=forks",
        "--maxWorkers=1"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Debug Vitest Test File",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vitest/vitest.mjs",
      "args": [
        "${file}",
        "run",
        "--pool=forks",
        "--maxWorkers=1"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "cwd": "${workspaceFolder}",
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/**",
        "!**/node_modules/**"
      ]
    },
    {
      "name": "Run Extension (Production Mode)",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/apex-lsp-vscode-extension"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/apex-lsp-vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "pnpm: compile",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps",
        "APEX_LS_MODE": "production"
      }
    },
    {
      "name": "Run Extension + Grafana",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/apex-lsp-vscode-extension"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "trace": true,
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "resolveSourceMapLocations": [
        "${workspaceFolder}/**",
        "!**/node_modules/**"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/apex-lsp-vscode-extension/out/**/*.js"
      ],
      "preLaunchTask": "Compile and Start Grafana",
      "env": {
        "NODE_OPTIONS": "--enable-source-maps",
        "APEX_LS_MODE": "development",
        "APEX_WORKER_EXPERIMENT": "1",
        "OTEL_EXPORTER_OTLP_ENDPOINT": "http://localhost:4318"
      }
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/apex-lsp-vscode-extension",
        "--extensionTestsPath=${workspaceFolder}/packages/apex-lsp-vscode-extension/out/test/suite/index"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/apex-lsp-vscode-extension/out/test/**/*.js"
      ],
      "sourceMaps": true,
      "smartStep": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/apex-lsp-vscode-extension/**",
        "!**/node_modules/**"
      ],
      "preLaunchTask": "pnpm: compile"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Debug Current Vitest Test",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": [
        "${relativeFile}",
        "run",
        "-c",
        "${workspaceFolder}/packages/apex-parser-ast/vitest.config.mts",
        "-t",
        "${selectedText}",
        "--pool=forks",
        "--maxWorkers=1"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/vitest/vitest.mjs"
      },
      "sourceMaps": true,
      "smartStep": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/apex-parser-ast/**",
        "!**/node_modules/**"
      ],
      "outFiles": ["${workspaceFolder}/packages/apex-parser-ast/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "env": {
        "NODE_OPTIONS": "--enable-source-maps"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Run All Vitest Tests in File",
      "runtimeExecutable": "${workspaceFolder}/node_modules/.bin/vitest",
      "args": [
        "${relativeFile}",
        "run",
        "-c",
        "${workspaceFolder}/packages/apex-parser-ast/vitest.config.mts",
        "--pool=forks",
        "--maxWorkers=1"
      ],
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen",
      "windows": {
        "runtimeExecutable": "${workspaceFolder}/node_modules/vitest/vitest.mjs"
      },
      "sourceMaps": true,
      "smartStep": true,
      "resolveSourceMapLocations": [
        "${workspaceFolder}/packages/apex-parser-ast/**",
        "!**/node_modules/**"
      ],
      "outFiles": ["${workspaceFolder}/packages/apex-parser-ast/**/*.js"],
      "skipFiles": ["<node_internals>/**", "**/node_modules/**"],
      "env": {
        "NODE_OPTIONS": "--enable-source-maps"
      }
    }
  ],
  "inputs": [
    {
      "id": "testName",
      "description": "Enter the test name pattern to run",
      "default": "",
      "type": "promptString"
    }
  ]
}
