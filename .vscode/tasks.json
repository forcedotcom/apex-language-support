{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "command": "pnpm run compile",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$tsc"],
      "label": "pnpm: compile",
      "detail": "Build all packages"
    },
    {
      "type": "shell",
      "command": "pnpm run clean",
      "label": "pnpm: clean",
      "detail": "Clean all packages"
    },
    {
      "type": "shell",
      "command": "pnpm run dev",
      "group": "build",
      "problemMatcher": ["$tsc-watch"],
      "label": "pnpm: dev",
      "detail": "Run development mode",
      "isBackground": true
    },
    {
      "type": "shell",
      "command": "pnpm run compile",
      "group": "build",
      "problemMatcher": ["$tsc"],
      "label": "pnpm: compile",
      "detail": "Compile all packages for development"
    },
    {
      "type": "shell",
      "command": "pnpm run bundle",
      "group": "build",
      "problemMatcher": [],
      "label": "pnpm: bundle",
      "detail": "Bundle all packages for development"
    },
    {
      "type": "shell",
      "command": "open",
      "args": ["${workspaceFolder}/coverage/lcov-report/index.html"],
      "label": "Open Coverage Report (Root)",
      "detail": "Open merged coverage HTML report in browser",
      "problemMatcher": [],
      "group": "test"
    },
    {
      "type": "shell",
      "command": "open",
      "args": [
        "${workspaceFolder}/packages/${input:packageName}/coverage/lcov-report/index.html"
      ],
      "label": "Open Coverage Report (Package)",
      "detail": "Open package-specific coverage HTML report",
      "problemMatcher": [],
      "group": "test",
      "inputs": [
        {
          "id": "packageName",
          "type": "promptString",
          "description": "Package name (e.g., apex-parser-ast, lsp-compliant-services)"
        }
      ]
    },
    {
      "label": "Start Grafana LGTM",
      "type": "shell",
      "command": "docker inspect --format='{{.State.Running}}' lgtm 2>/dev/null | grep -q true || docker start lgtm 2>/dev/null || docker run -d --name lgtm -p 3000:3000 -p 3100:3100 -p 3200:3200 -p 4317:4317 -p 4318:4318 grafana/otel-lgtm",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      },
      "isBackground": false,
      "problemMatcher": []
    },
    {
      "label": "Compile and Start Grafana",
      "dependsOn": ["Start Grafana LGTM", "pnpm: compile"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
